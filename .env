# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=HRMS_DEV_LIVE_DATA
DB_USER=root
DB_PASSWORD=
DB_ECHO=false

# --- Server ---
SERVER_PORT=8084
# Public host/port used to build absolute URLs for uploaded files / profile images.
# Leave blank to fall back to the incoming request's host.
PUBLIC_HOST=
PUBLIC_PORT=8000

# --- File storage ---
FILE_STORAGE_ROOT=./kms_uploads
PROFILE_IMAGES_PATH=./kms_uploads/Profile Images

# --- JWT ---
JWT_SECRET=mksSecretKey
JWT_EXPIRATION_MS=86400000

# --- Uploads ---
MAX_UPLOAD_SIZE_BYTES=1073741824

# --- Confidential file access ---
CONFIDENTIAL_FILE_USERS=vani.rajan@mksvision.com,palanivel.subramaniyan@mksvision.com

# --- Microsoft Graph (email) ---
MS_GRAPH_CLIENT_ID=32d21830-dd51-41c5-a8ee-dd59fdb9a642
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=065e5f45-d38c-406e-8194-408da2f802ed
