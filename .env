# --- Password reset ---
RESET_PASSWORD_LINK=http://192.168.10.49:443/kms-local/#/forgot-password
RESET_PASSWORD_EXPIRY_MINUTES=15

# =========================================================================
# HRMS module (recruitment/employee-management, ported from SMS_Php_laurvel)
# Separate MySQL database (mksvision_mkswebsite_new) - distinct connection from the
# KMS module's MySQL DB above (lmsdev), same server or a different one either way.
# =========================================================================

# --- Database ---
HRMS_DB_HOST=localhost
HRMS_DB_PORT=3306
HRMS_DB_NAME=HRMS_DEV_LIVE_DATA
HRMS_DB_USER=root
HRMS_DB_PASSWORD=
HRMS_DB_ECHO=false
# Full connection string override - set this instead of the HRMS_DB_* fields above to
# point BOTH the app and `alembic -c alembic_hrms.ini upgrade head` at any
# SQLAlchemy-supported database (MySQL, Postgres, ...) with no code changes. Example for
# a Neon/Postgres copy (uncomment and fill in):
# HRMS_DATABASE_URL=postgresql+asyncpg://user:password@host/dbname
HRMS_DATABASE_URL=postgresql+asyncpg://neondb_owner:npg_lWPTCkQixK61@ep-mute-bonus-azco7c1l-pooler.c-3.ap-southeast-1.aws.neon.tech/Dev_HRMS
DATABASE_URL=postgresql+asyncpg://neondb_owner:npg_lWPTCkQixK61@ep-mute-bonus-azco7c1l-pooler.c-3.ap-southeast-1.aws.neon.tech/Dev_HRMS
# --- JWT ---
HRMS_JWT_SECRET=changeme-hrms-secret
HRMS_JWT_EXPIRATION_MINUTES=120

# --- File storage (mirrors Laravel's public_path('uploads') layout) ---
HRMS_UPLOAD_ROOT=./hrms_uploads

# --- Defaults ---
HRMS_DEFAULT_PASSWORD=Welcome@123

# --- SMTP (replaces Laravel's Mail facade) ---
HRMS_SMTP_HOST=smtp-mail.outlook.com
HRMS_SMTP_PORT=587
HRMS_SMTP_USERNAME=noreply@mksvision.com
HRMS_SMTP_PASSWORD=zsjhssbhgwhczxnd
HRMS_SMTP_USE_TLS=true
HRMS_MAIL_FROM_ADDRESS=noreply@mksvision.com
HRMS_MAIL_FROM_NAME=MKS HRMS

# --- Notification recipients (were hardcoded in the Laravel app) ---
HRMS_CANDIDATE_SUBMISSION_NOTIFY_EMAIL=
HRMS_PROFILE_UPDATE_NOTIFY_EMAIL=
HRMS_ONBOARDING_NOTIFY_EMAIL=hr@mksvision.com

# --- Webhook auth (the Laravel routes had none - closes that security gap) ---
HRMS_WEBHOOK_API_KEY=changeme-webhook-key

# --- Frontend base URL (used to build links in emails) ---
HRMS_FRONTEND_BASE_URL=http://localhost:5173

# --- Work locations (Users module "Work Location" dropdown, comma-separated) ---
HRMS_WORK_LOCATIONS=Hyderabad,Coimbatore